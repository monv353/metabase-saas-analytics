# Copy to .env and fill in. .env is git-ignored and is copied to myserver by `make deploy`.
# Generate passwords with e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(18))"

# Postgres owner of the warehouse (used only by the seed scripts)
WAREHOUSE_ADMIN_PASSWORD=change-me
# Read-only role Metabase uses to query the warehouse
WAREHOUSE_READER_PASSWORD=change-me
# Metabase application database password
MB_DB_PASS=change-me

# First Metabase admin, created by provision.py
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me-min-8-chars-1-digit
MB_ADMIN_FIRST_NAME=Michael
MB_ADMIN_LAST_NAME=Hanjaya

# Where provision.py reaches Metabase (it runs on myserver, so loopback is right)
MB_URL=http://127.0.0.1:3300
